{
  "name": "sands-of-time",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:harness": "vitest run tests/adaptation.test.ts tests/campaign.test.ts tests/playtest.test.ts --reporter=verbose",
    "test:resilience": "vitest run tests/resilience.test.ts --reporter=verbose",
    "harness": "vite --host 0.0.0.0 --open /?harness=campaign",
    "format": "prettier --write src tests index.html README.md package.json tsconfig.json",
    "format:check": "prettier --check src tests index.html README.md package.json tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vite": "^7.1.9",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
